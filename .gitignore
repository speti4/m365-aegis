# .NET build output and tool state
bin/
obj/
.vs/
TestResults/
*.user
*.suo
artifacts/
dist/
# A failed snapshot test writes the rendering it got next to the expected one; accepting it is renaming it to
# .verified. (docs/development.md, "The output contract"), so the received file never travels.
*.received.*

# The front end's packages and build; the build travels as wwwroot/ inside the GUI's output, never in git
gui/web/node_modules/
gui/web/dist/
gui/web/.vite/
*.tsbuildinfo

# Tenant data never enters the repo: a tenant profile, an MSAL cache, a recorded answer that was not scrubbed, a
# token or a certificate (CLAUDE.md, "Data outside the repo"). The scrubbed fixtures under tests/fixtures are
# the one place a JSON answer lives, and check-fixtures.py holds them to made-up names.
config.json
msal-cache*.bin
*.pfx
*.p12
*.cer
*.token
captures/

# local: editor folders, the anonymizer's token map, the maintainer's local instructions
.env
*.log
.DS_Store
.vscode/
.idea/
*.anonilm-map.json
.claude/settings.local.json
CLAUDE.local.md
__pycache__/

# git worktrees that Claude Code creates under .claude/worktrees (docs/maintainer-sessions.md)
.claude/worktrees/

# The maintainer's Claude memory lives next to the repo, never in it; the committed .claude/settings.json keeps
# pointing at it
.claude/memory/

# An MSBuild binary log carries the whole environment, a dump carries memory
*.binlog
*.dmp

# Keys and local secrets beyond the certificates listed above
*.pem
*.key
*.snk
*.publishsettings
secrets.json
.env.*

# Test and coverage output written to the working folder (Pester -CI, coverlet, Playwright)
testResults.xml
coverage*.xml
*.trx
coverage/
test-results/
playwright-report/

# Python
*.pyc
.pytest_cache/
.venv/

# Editor and merge leftovers
*.DotSettings.user
.vshistory/
Thumbs.db
Desktop.ini
*.orig
*.rej
*~

# The WebView2 user data folder an exe creates next to itself when run outside the home folder
*.WebView2/
EBWebView/
