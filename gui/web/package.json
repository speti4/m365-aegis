{
  "name": "m365-aegis-web",
  "private": true,
  "version": "0.1.0",
  "description": "The front end of the m365-aegis window: Vite + React + Tailwind + shadcn/ui, built into dist/ and shipped as wwwroot/ next to m365-aegis-gui.exe.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
