<!-- The library: auth, the Graph client, the Exchange Online backends, the operations with their plans, the
     output contract and the doctor checks. Plain net10.0, not net10.0-windows, so the tests run on Linux; the
     Windows-only paths (WAM, DPAPI, the registry) sit behind OperatingSystem.IsWindows() and CA1416 checks them. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>M365Aegis.Core</RootNamespace>
    <!-- The exes publish for win-x64 (D-007) and the publish restore carries the runtime identifier into every
         referenced project, so the Core's lock file needs the win-x64 targets too, or the locked restore of the
         release fails. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The source-generated P/Invokes (LibraryImport: the console window handle the account picker attaches to)
         need it; no other code of the Core is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Core and Cli tests see the internals. -->
    <InternalsVisibleTo Include="M365Aegis.Core.Tests" />
    <InternalsVisibleTo Include="M365Aegis.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sign-in (task 002 / D-003): MSAL.NET, the Windows account manager through the broker package, and the
         file cache under the home folder; the versions and the reasons are in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Exchange Online sidecar script travels next to every exe that references the Core, as sidecar\ (D-004);
         the doctor checks its hash and the release zip carries it at the same path. -->
    <None Include="Exchange\Sidecar\aegis-exo-sidecar.ps1" Link="sidecar\aegis-exo-sidecar.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
