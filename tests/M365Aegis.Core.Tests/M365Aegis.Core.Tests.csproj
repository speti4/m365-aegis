<!-- The Core tests: xUnit v3 on Microsoft.Testing.Platform (an executable test project), offline, against the
     fixtures under tests/fixtures; the snapshot tests (Verify) keep their files under Snapshots/. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>M365Aegis.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\M365Aegis.Core\M365Aegis.Core.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Verify.XunitV3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample reader both test projects share (tests/shared). -->
    <Compile Include="..\shared\DoctorSamples.cs" Link="shared\DoctorSamples.cs" />
    <Compile Include="..\shared\AuthSamples.cs" Link="shared\AuthSamples.cs" />
    <!-- The recorded Graph answers are read from the source tree, not copied (tests/fixtures/graph). -->
    <Compile Include="..\shared\GraphFixtures.cs" Link="shared\GraphFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bridge contract samples, shared with the front end's Vitest tests (tests/contracts/bridge). -->
    <Content Include="..\contracts\bridge\*.json" Link="contracts\bridge\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The scrubbed doctor reports and sign-in results the snapshot tests render (tests/fixtures/doctor, tests/fixtures/auth). -->
    <Content Include="..\fixtures\doctor\*.json" Link="fixtures\doctor\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\auth\*.json" Link="fixtures\auth\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The made-up `dsregcmd /status` outputs the device check parses (tests/fixtures/doctor, task 008). -->
    <Content Include="..\fixtures\doctor\*.txt" Link="fixtures\doctor\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
