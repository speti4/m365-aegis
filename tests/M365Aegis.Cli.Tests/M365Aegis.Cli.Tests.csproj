<!-- The command line end to end: the tests start the built m365-aegis assembly as a child process and check its
     output and exit code, the way a shell or a Claude Code session sees it; the snapshot tests (Verify) and the
     table view tests render the result types in process and keep their files under Snapshots/. Under coverlet
     the child processes load the instrumented assembly next to the tests and their hits count too (task 070). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>M365Aegis.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The exe project reference puts m365-aegis.dll and its runtimeconfig next to the tests. -->
    <ProjectReference Include="..\..\src\M365Aegis.Cli\M365Aegis.Cli.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="coverlet.MTP" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample reader both test projects share (tests/shared). -->
    <Compile Include="..\shared\DoctorSamples.cs" Link="shared\DoctorSamples.cs" />
    <Compile Include="..\shared\AuthSamples.cs" Link="shared\AuthSamples.cs" />
    <!-- The recorded Graph answers are read from the source tree, not copied (tests/fixtures/graph). -->
    <Compile Include="..\shared\GraphFixtures.cs" Link="shared\GraphFixtures.cs" />
    <!-- The sidecar against the fake ExchangeOnlineManagement module (tests/sidecar/modules). -->
    <Compile Include="..\shared\SidecarFixtures.cs" Link="shared\SidecarFixtures.cs" />
    <!-- The plans of the write tests: a store in a temporary home, a made-up plan, the sample CSV files (task 051). -->
    <Compile Include="..\shared\PlanSamples.cs" Link="shared\PlanSamples.cs" />
    <!-- Three plan records in a temporary home, for plan list, plan show and the resume (tasks 060 and 062). -->
    <Compile Include="..\shared\PlanRecordSamples.cs" Link="shared\PlanRecordSamples.cs" />
    <!-- The marked tokens of the token-hygiene tests (tasks 072 and 080). -->
    <Compile Include="..\shared\MarkedTokenBroker.cs" Link="shared\MarkedTokenBroker.cs" />
    <!-- The request log of the fixture transport read for its writes (tasks 071 and 079). -->
    <Compile Include="..\shared\SentRequests.cs" Link="shared\SentRequests.cs" />
    <!-- The fixture snapshot: a take over the fixtures and the fake module, once per run (task 087). -->
    <Compile Include="..\shared\SnapshotSamples.cs" Link="shared\SnapshotSamples.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scrubbed doctor reports and sign-in results the snapshot tests render (tests/fixtures/doctor, tests/fixtures/auth). -->
    <Content Include="..\fixtures\doctor\*.json" Link="fixtures\doctor\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\auth\*.json" Link="fixtures\auth\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
